# Copiar a .env.local (git-ignored) y rellenar con las credenciales reales.

# --- Datos del ERP -----------------------------------------------------------
# Pooler de Supabase en TRANSACTION MODE (6543). Es el de runtime — las
# migraciones del schema `ops` usan session mode (5432) y viven aparte, en
# ../migracion/ (CLAUDE.md §4).
#
# Sólo se usa desde el servidor. NO lleva prefijo NEXT_PUBLIC_ a propósito:
# cualquier variable con ese prefijo viaja al navegador.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# --- Identidad (Supabase Auth) -----------------------------------------------
# Dashboard de Supabase → Project Settings → API.
#
# La clave `anon` / publishable SÍ es pública por diseño: va al navegador y no
# da acceso a nada por sí sola. La que NUNCA debe aparecer aquí ni en el código
# es `service_role`.
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-o-publishable-key]
