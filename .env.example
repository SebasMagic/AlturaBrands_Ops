# =============================================================================
# Mini ERP AlturaBrands — plantilla de entorno
# Copia a `.env` y rellena. `.env` está en .gitignore y no se commitea.
# =============================================================================

# -----------------------------------------------------------------------------
# Postgres (Supabase) — CLAUDE.md §10
# -----------------------------------------------------------------------------
# Las dos apuntan a la MISMA base. Cambian el puerto y el modo, y NO son
# intercambiables. Cópialas del botón "Connect" del dashboard de Supabase,
# pestaña "Direct — Connection string".
#
# Runtime — transaction pooler, puerto 6543.
#   pgbouncer=true      el pooler no soporta prepared statements en este modo
#   uselibpqcompat=true desde pg 8.16, sslmode=require se interpreta como
#                       verify-full y el certificado del pooler no encadena con
#                       las CA del sistema: sin esto muere con
#                       SELF_SIGNED_CERT_IN_CHAIN
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true

# Migraciones y DDL — session pooler, puerto 5432.
# El transaction pooler rompe las migraciones de forma confusa.
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true

# -----------------------------------------------------------------------------
# Supabase — API, Auth y Storage
# -----------------------------------------------------------------------------
# Settings → API en el dashboard.
SUPABASE_URL=https://[ref].supabase.co

# Clave pública. Va en el frontend y respeta RLS: un usuario solo ve lo que sus
# políticas permiten. Es segura de exponer PORQUE RLS está activo — si alguna
# tabla se queda sin políticas, deja de serlo.
SUPABASE_ANON_KEY=

# Clave de servicio. **HACE BYPASS DE RLS.** Solo para scripts de carga y
# migración que corren en tu máquina o en el servidor. Jamás en el frontend,
# jamás en una variable que empiece por NEXT_PUBLIC_ o VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Operación por defecto para los scripts de carga
# -----------------------------------------------------------------------------
# El código de la operación-país sobre la que trabajan los ETL y las cargas.
# Al añadir países, los scripts se parametrizan por esto en vez de duplicarse.
DEFAULT_OPERATION=CO
