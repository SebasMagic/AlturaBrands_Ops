# =============================================================================
# AlturaBrands Ops — plantilla de entorno
# Copia este archivo a `.env` y rellena los valores. `.env` está en .gitignore
# y nunca debe commitearse.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos — Supabase (CLAUDE.md §3)
# -----------------------------------------------------------------------------
# Las dos cadenas apuntan a la MISMA base. Cambia el puerto y el modo, y no son
# intercambiables. Cópialas del botón "Connect" del dashboard de Supabase.
#
# Runtime — transaction pooler, puerto 6543.
# `pgbouncer=true` desactiva prepared statements, que el pooler no soporta en
# transaction mode. Sin esto verás errores de "bind message" en producción.
#
# `uselibpqcompat=true` es imprescindible: desde pg 8.16, `sslmode=require` se
# interpreta como `verify-full` y exige validar toda la cadena de certificados.
# El pooler de Supabase presenta un certificado que no encadena con las CA del
# sistema, así que sin este parámetro la conexión muere con
# SELF_SIGNED_CERT_IN_CHAIN. Con él se mantiene el cifrado pero no se valida la
# cadena. Endurecerlo (fijar la CA de Supabase) queda pendiente para producción.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true

# Migraciones — session pooler, puerto 5432.
# Solo la usan `pnpm db:migrate`, `pnpm db:generate` y `pnpm user:create`, vía
# la bandera MEDUSA_DB_MODE=migration. Si una migración falla hablando de
# prepared statements, casi siempre es que esta variable está mal.
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true

# -----------------------------------------------------------------------------
# Redis — cache, event bus y workflow engine (CLAUDE.md §9.3)
# -----------------------------------------------------------------------------
# EN LOCAL: déjala VACÍA. Medusa cae a cache y event bus en memoria, que basta
# para desarrollar. No es una limitación teórica: el event bus usa BullMQ, que
# mantiene conexiones bloqueantes sondeando Redis de forma continua incluso con
# el sistema en reposo. Con un servidor de desarrollo encendido unas horas se
# consumieron los 500.000 comandos del tier gratuito de Upstash.
#
# EN DESPLIEGUE: obligatoria — sin ella no hay proceso worker separado (§4.6)
# ni jobs fiables. Pero NO uses un plan que cobre por comando: para una carga
# como la de BullMQ sale carísimo y se agota sin aviso. Usa un Redis de tarifa
# fija colocalizado con el server (Railway ofrece uno), que además reduce la
# latencia respecto a un servicio externo.
#
# Con TLS el esquema lleva doble s: rediss://
REDIS_URL=

# -----------------------------------------------------------------------------
# Secretos de sesión
# -----------------------------------------------------------------------------
# Genera valores únicos por entorno. NO reutilices los de dev en producción:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# En Fase 1 toda la UI vive dentro del admin (§4.5), así que solo hacen falta
# los orígenes locales. STORE_CORS quedará relevante en Fase 2, cuando existan
# frontends separados.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000

# -----------------------------------------------------------------------------
# Worker (CLAUDE.md §4.6)
# -----------------------------------------------------------------------------
# Ambos procesos de Railway corren este mismo código y se diferencian aquí:
#   server → HTTP API + Admin
#   worker → jobs, eventos, colas
# En local se deja en `shared`: un solo proceso hace ambas cosas.
MEDUSA_WORKER_MODE=shared
