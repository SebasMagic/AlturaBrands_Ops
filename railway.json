{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm build && ln -sfn \"$PWD/node_modules\" .medusa/server/node_modules && ls -l .medusa/server/node_modules"
  },
  "deploy": {
    "startCommand": "cd .medusa/server && pnpm run predeploy && pnpm run start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
